# Copy to .env (repo root or backend/) - never commit .env. All backend settings use the TI_ prefix
# (backend/traffic_intel/core/config.py AppSettings). Everything has a working local default.

TI_ENV=dev
TI_LOG_LEVEL=INFO
TI_LOG_FORMAT=text                       # text | json

# Database. Unset = local SQLite file data/db/traffic.db (zero setup).
# PostgreSQL / PostGIS (PostGIS geometry is used automatically when the extension is available):
# TI_DATABASE_URL=postgresql+psycopg://traffic:CHANGE_ME@localhost:5432/traffic

# Paths (defaults: <repo>/configs, <repo>/data, <repo>/models)
# TI_CONFIG_DIR=
# TI_DATA_DIR=
# TI_MODELS_DIR=

# API / dashboard
TI_API_CORS_ORIGINS=["http://localhost:5173"]
# Optional future push channel (/ws/traffic). The dashboard polls REST and does not need it.
TI_WS_ENABLED=false
TI_WS_PUSH_INTERVAL_S=1.0
TI_LIVE_STALE_S=10                       # live values older than this are shown as stale
TI_WINDOW_STALE_S=180                    # 60 s windows older than this are shown as stale
TI_CAMERA_OFFLINE_S=15                   # camera heartbeat timeout

# Event bus: "memory" (single runtime process). "redis" is FUTURE scope (separate camera processes).
TI_BUS_BACKEND=memory
# TI_REDIS_URL=redis://localhost:6379/0
