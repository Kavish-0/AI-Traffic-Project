# Copy to frontend/.env.local (never commit).
# Where the Vite dev server proxies /api (default http://localhost:8000).
# VITE_BACKEND_URL=http://localhost:8000
# Basemap: any MapLibre style URL. Unset = offline schematic background (roads, junctions, cameras only).
# VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# Dashboard REST polling intervals in ms (values < 1000 are ignored). The dashboard does not use WebSockets.
# Live traffic values: KPIs, selected road, new-window detection (2000-5000 recommended).
# VITE_POLL_LIVE_MS=3000
# Camera and system status.
# VITE_POLL_STATUS_MS=10000
# Safety refresh of per-window panels (they are refetched as soon as a new window is detected anyway).
# VITE_POLL_SLOW_MS=30000
